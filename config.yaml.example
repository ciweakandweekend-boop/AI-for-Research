# Example configuration for the local paper-driven AI-for-Science workflow.
# Credentials must stay outside YAML/Git. Set these variables in .env or the
# shell environment before using --mode live:
#   ANTHROPIC_API_KEY, QWEN_API_KEY (or DASHSCOPE_API_KEY),
#   GROQ_API_KEY

user:
  name: Demo Researcher

anthropic_api_key: ""
model: "claude-sonnet-4-6"

api_keys:
  groq: ""
  qwen: ""

agents:
  - name: Planner
    provider: dashscope
    model: "qwen3.8-max"
    api_key_name: qwen
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    max_tokens: 4096
    timeout: 45
    extra_body:
      enable_thinking: false
      preserve_thinking: false
    specialty: Research planning
    description: Breaks the question into subquestions, keywords, and analysis criteria.

  # Paper Reader also uses Qwen3.8-Max over DashScope.
  - name: Paper Reader
    provider: dashscope
    model: "qwen3.8-max"
    api_key_name: qwen
    base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
    max_tokens: 16384
    timeout: 45
    extra_body:
      enable_thinking: false
      preserve_thinking: false
    specialty: Evidence extraction
    description: Reads local PDF chunks and returns page-cited evidence only.

  - name: Hypothesis Generator
    provider: groq
    model: "openai/gpt-oss-120b"
    api_key_name: groq
    max_tokens: 8192
    timeout: 45
    extra_body:
      reasoning_effort: low
      include_reasoning: false
    specialty: Scientific hypothesis generation
    description: Converts validated evidence into mechanisms and testable predictions.

  - name: Critical Reviewer
    provider: anthropic
    model: "claude-sonnet-4-6"
    api_key_name: anthropic
    max_tokens: 8192
    timeout: 45
    system_prompt: >-
      Identify unsupported claims, methodological weaknesses, confounding
      variables, and missing evidence. Return only the required JSON object.
    specialty: Critical scientific review
    description: Challenges hypotheses and flags claims that the evidence cannot support.

  - name: Scientific Director
    provider: anthropic
    model: "claude-sonnet-4-6"
    max_tokens: 12288
    timeout: 45
    specialty: Scientific synthesis
    description: Produces the final report with evidence, limitations, and next experiment.
